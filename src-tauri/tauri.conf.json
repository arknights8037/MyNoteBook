{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myNoteBook",
  "version": "0.1.0",
  "identifier": "com.local.mynotebook",
  "build": {
    "beforeDevCommand": "pnpm --filter @mynotebook/agent-runtime-worker build:sidecar && pnpm build:qoder-bridge && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build && pnpm --filter @mynotebook/agent-runtime-worker build:sidecar && pnpm build:qoder-bridge -- --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "myNoteBook",
        "visible": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:"],
        "font-src": ["'self'", "data:"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "worker-src": ["'self'", "blob:"],
        "frame-src": ["'self'"],
        "media-src": ["'self'", "data:", "blob:"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"]
      },
      "devCsp": {
        "default-src": ["'self'", "http://127.0.0.1:1420"],
        "script-src": ["'self'", "'unsafe-eval'", "'wasm-unsafe-eval'", "http://127.0.0.1:1420"],
        "style-src": ["'self'", "'unsafe-inline'", "http://127.0.0.1:1420"],
        "img-src": ["'self'", "data:", "blob:"],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://127.0.0.1:1420",
          "ws://127.0.0.1:1420"
        ],
        "worker-src": ["'self'", "blob:", "http://127.0.0.1:1420"],
        "frame-src": ["'self'"],
        "media-src": ["'self'", "data:", "blob:"],
        "object-src": ["'none'"],
        "base-uri": ["'none'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agent-runtime-worker", "binaries/qoder-mcp-bridge"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
